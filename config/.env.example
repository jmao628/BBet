# Copy this to .env and fill in your secrets
# NEVER commit .env to version control

# Database
DATABASE_URL=postgresql+asyncpg://bpmde:password@localhost:5432/bpmde
DATABASE_URL_SYNC=postgresql+psycopg2://bpmde:password@localhost:5432/bpmde

# Redis
REDIS_URL=redis://localhost:6379/0

# Kalshi
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_API_SECRET=your_kalshi_api_secret_here  # if needed

# Polymarket (CLOB API key)
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_PRIVATE_KEY=your_polymarket_private_key_here  # for order signing

# The Odds API
ODDS_API_KEY=your_odds_api_key_here

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
ALERT_EMAIL=alerts@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password

# Environment
ENV=development  # development | staging | production
LOG_LEVEL=INFO
